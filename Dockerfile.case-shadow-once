# Dedicated offline C.A.S.E. verifier image. It does not contain the live bot binary.
# Staging/production execution must be manually approved and fingerprint gated.
FROM golang:1.25-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/case-shadow-once ./cmd/case-shadow-once && \\\n    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/case-shadow-qa-setup ./cmd/case-shadow-qa-setup

FROM alpine:3.20
RUN addgroup -S app && adduser -S -G app app
WORKDIR /app
COPY --from=builder /out/case-shadow-once /app/case-shadow-once
COPY --from=builder /out/case-shadow-qa-setup /app/case-shadow-qa-setup
USER app
# Deliberately inert by default: no endpoint, poller, migration, or database read.
# An approved one-off invocation must explicitly override the command.
CMD ["sh", "-c", "echo CASE_SHADOW_QA_INERT_NO_DATABASE"]
