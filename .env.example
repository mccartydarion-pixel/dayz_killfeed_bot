APP_ENV=development
HTTP_PORT=8080
PORT=8080

DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=

NITRADO_TOKEN=
NITRADO_SERVICE_ID=

KILLFEED_CHANNEL_ID=

# Optional: polling interval for the Nitrado log engine (default 2s, minimum 1s)
NITRADO_POLL_INTERVAL=2s

# Optional: set to "debug" to enable checkpoint debug logging
LOG_LEVEL=info

DATABASE_URL=

# Required for /server connect. Generate once and keep it stable across deploys.
# PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
CREDENTIAL_ENCRYPTION_KEY=

# Optional: Discord bot presence/activity. Defaults shown - omit to use them.
DISCORD_PRESENCE_ENABLED=true
DISCORD_PRESENCE_ROTATION_SECONDS=45
DISCORD_PRESENCE_MODE=dynamic

# Optional: comma-separated Discord user ids allowed to use the read-only platform-admin API
# (/api/admin/*, see docs/ADMIN_API.md). Empty = nobody (the admin API fails closed).
CHAMPION_ADMIN_DISCORD_IDS=

# Optional: Embed Designer runtime rendering (docs/EMBED_RUNTIME.md). Default false: every
# publisher uses the Champion default cards. true: eligible routes render an installation's
# saved custom embed template (falling back to the default on any problem).
CHAMPION_CUSTOM_EMBEDS_ENABLED=false

# Optional: the public origin of this service (a bare https://host, no path). Used to build absolute
# URLs for publicly served assets such as faction logos (/assets/faction-logos/...). Defaults to
# Railway's RAILWAY_PUBLIC_DOMAIN; with neither set the API returns root-relative URLs.
CHAMPION_PUBLIC_BASE_URL=

# Champion Billing (docs/BILLING.md). Server-only secrets - NEVER commit real values here, and never
# put a real key in any doc. Empty = billing runs unconfigured (every billing action fails closed with
# BILLING_UNAVAILABLE) rather than the service failing to start.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The authoritative plan catalog (see internal/billing.LoadCatalog and docs/BILLING.md "Pricing
# configuration handoff" for the exact JSON shape). Empty = no plan approved yet. This is never
# hardcoded into Go - it is always sourced from this one environment variable.
CHAMPION_BILLING_PLANS_JSON=

# Optional: extra site origins (beyond https://championshp.vip) a Checkout/Portal return URL may
# target, comma-separated, e.g. a local website dev server such as http://localhost:3000.
CHAMPION_BILLING_ALLOWED_ORIGINS=
