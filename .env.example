# Champion bot - example environment.
#
# Copy to .env for local development (the bot loads .env at start-up) and fill in what you need.
# In production these are set as deployment variables (Railway), never committed.
# NEVER put a real token, key, password or id in this file. Everything below is a default or blank.
#
# Only DISCORD_TOKEN is required to start. Everything else is optional: a blank value means
# "use the default" or "this feature is off".

# ---------------------------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------------------------

# development (default), staging or production. "staging" is the only value that permits
# NITRADO_API_BASE_URL, and it refuses a live Stripe key.
APP_ENV=development

# HTTP listen port. PORT wins (Railway sets it); HTTP_PORT is the local fallback. Default 8080.
PORT=8080
HTTP_PORT=8080

# debug, info (default), warn or error.
LOG_LEVEL=info
# json (default; Railway parses the level) or text.
LOG_FORMAT=json

# PostgreSQL connection string, e.g. postgres://user:password@localhost:5432/champion?sslmode=disable
# Blank = the bot starts without a database (most features are then unavailable).
DATABASE_URL=

# Required for /server connect: encrypts stored Nitrado credentials. A stable 32-byte value or a
# base64-encoded 32-byte value. Generate once and keep it the same across deploys.
# PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
CREDENTIAL_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------------------------

# REQUIRED. The bot token from the Discord developer portal.
DISCORD_TOKEN=
# The Discord application id of the bot.
DISCORD_APPLICATION_ID=
# The home Discord server (guild) id: guild-scoped commands are registered there.
DISCORD_GUILD_ID=
# Legacy single-server fallback channel for the killfeed. Installations set up through the website
# or /setup use their own channel routes instead.
KILLFEED_CHANNEL_ID=
# Set to true only if the privileged "Server Members" intent is enabled for the bot in the Discord
# developer portal. Default false.
DISCORD_GUILD_MEMBERS_INTENT_ENABLED=false

# Bot presence/activity. Defaults shown.
DISCORD_PRESENCE_ENABLED=true
# 30-300 seconds, default 45.
DISCORD_PRESENCE_ROTATION_SECONDS=45
# static or dynamic.
DISCORD_PRESENCE_MODE=dynamic

# How often the Discord PvP heatmap summary refreshes (minutes, 5-1440, default 30).
HEATMAP_DISCORD_INTERVAL_MINUTES=30

# ---------------------------------------------------------------------------------------------
# Nitrado and log polling
# ---------------------------------------------------------------------------------------------

# Legacy single-server Nitrado token and service id. Servers connected with /server connect or
# through the website store their own (encrypted) credentials and do not use these.
NITRADO_TOKEN=
NITRADO_SERVICE_ID=

# How often each server's log is checked (docs/NITRADO_POLLING.md). Default 10s, minimum 1s.
NITRADO_POLL_INTERVAL=10s
# The faster interval used while a server's log is changing and the Nitrado rate limit has headroom.
# Default 3s; "off" or "0" disables it.
NITRADO_POLL_INTERVAL_FAST=3s
# Partial log reads (docs/NITRADO_DELTA_READS.md): off (default), auto, seek, offset_query or range.
# Anything else means off. Probe a service with cmd/nitrado-delta-probe before turning this on.
NITRADO_DELTA_READ_MODE=off
# Set to "off" to stop the Live Sync watchers (docs/CHAMPION_LIVE_SYNC.md). Default: on.
LIVE_SYNC_WATCHERS=
# Set to "immediate" to post each kill/death card as soon as it is saved. Default: the rotating cycle.
KILLFEED_DELIVERY_MODE=
# Set to true to log a sample of raw log lines (at DEBUG level) for parser diagnostics. Default false.
ADM_SAMPLE_DEBUG=false
# STAGING ONLY: replaces the Nitrado API with the synthetic fixture (cmd/nitrado-fixture), e.g.
# http://localhost:8081. The bot refuses to start with this set unless APP_ENV=staging.
NITRADO_API_BASE_URL=

# ---------------------------------------------------------------------------------------------
# Website and Owner Hub APIs
# ---------------------------------------------------------------------------------------------

# The shared secret the website sends as a bearer token to /api/saas, /api/admin and
# /api/runtime/status (docs/SAAS_API.md). Blank = those APIs answer nobody.
WEBSITE_API_SECRET=

# Comma-separated Discord user ids of the platform owners (docs/ADMIN_API.md "Roles"), e.g.
# 100000000000000001,100000000000000002. An owner has full access to the Owner Hub (/api/admin/*)
# and manages the view-only platform staff list there; staff are stored in the database, never here.
# Blank = no owner (the admin API then only answers staff, who can change nothing).
CHAMPION_ADMIN_DISCORD_IDS=

# The public origin of this service (a bare https://host, no path), used to build absolute URLs for
# publicly served assets such as faction logos. Defaults to Railway's RAILWAY_PUBLIC_DOMAIN (set by
# Railway itself); with neither set the API returns root-relative URLs.
CHAMPION_PUBLIC_BASE_URL=
# The public origin of the website (a bare https://host), used for links in Discord cards.
CHAMPION_SITE_BASE_URL=

# ---------------------------------------------------------------------------------------------
# Feature switches (all off by default)
# ---------------------------------------------------------------------------------------------

# Embed Designer runtime rendering (docs/EMBED_RUNTIME.md). false: every publisher uses the
# Champion default cards. true: eligible routes render an installation's saved template.
CHAMPION_CUSTOM_EMBEDS_ENABLED=false

# Plan tiers (internal/entitlements). false: every plan gets every feature. true: the Survivor
# plan loses the Champion-only features.
CHAMPION_PLAN_GATING_ENABLED=false

# Map rotation with a player vote (docs/MAP_ROTATION.md): the default of the map_rotation feature
# flag for every installation. Leave it off and switch single installations on in the Owner Hub.
CHAMPION_MAP_ROTATION_ENABLED=false

# Shop canary operator API lock (docs/SHOP_DELIVERY_PHASE2C4.md). Opens only for the exact word
# "enabled" AND the installation ids listed (comma-separated). Anything else: locked.
CHAMPION_SHOP_CANARY_EXECUTION=
CHAMPION_SHOP_CANARY_INSTALLATION_IDS=

# Shop automatic delivery worker (docs/SHOP_DELIVERY_WORKER.md). Runs only for the exact word
# "report" (logs what it would do) or "enabled" (delivers) AND the installation ids listed
# (comma-separated). Anything else: no worker. MAX_STAGED is 1 unless set to 2-5.
CHAMPION_SHOP_AUTO_DELIVERY=
CHAMPION_SHOP_AUTO_DELIVERY_INSTALLATION_IDS=
CHAMPION_SHOP_AUTO_DELIVERY_MAX_STAGED=

# C.A.S.E. evidence collection (docs/CASE_PHASE2B.md). true plus the internal game_servers ids
# (comma-separated) it is allowed for. Observation only; no detector is enabled by this.
CASE_EVIDENCE_ENABLED=false
CASE_EVIDENCE_SERVER_IDS=
# true lets a server owner's own switch count like the list above (needs CASE_EVIDENCE_ENABLED=true).
CASE_EVIDENCE_SELF_SERVE=false
# Also keep build/placement lines as evidence, for the listed server ids (needs the collector on).
CASE_BUILD_EVIDENCE_ENABLED=false
CASE_BUILD_EVIDENCE_SERVER_IDS=

# ---------------------------------------------------------------------------------------------
# Billing (docs/BILLING.md) - server-only secrets
# ---------------------------------------------------------------------------------------------

# Blank = billing runs unconfigured (every billing action fails closed with BILLING_UNAVAILABLE)
# rather than the service failing to start. Use test-mode keys (sk_test_...) outside production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The plan catalog as one JSON value (see internal/billing.LoadCatalog and docs/BILLING.md "Pricing
# configuration handoff" for the shape). Blank = no plan approved yet. Never hardcoded in Go.
CHAMPION_BILLING_PLANS_JSON=

# Extra site origins, comma-separated, that a Checkout/Portal return URL may target besides the
# built-in production site origin, e.g. a local website dev server: http://localhost:3000
CHAMPION_BILLING_ALLOWED_ORIGINS=

# C.A.S.E. paid add-on (docs/CASE_PHASE6_BILLING.md). Both switches default to false: no checkout
# and no premium access. The price ids are Stripe price ids (price_...), blank until approved.
CHAMPION_CASE_BILLING_ENABLED=false
CHAMPION_CASE_ACCESS_ENABLED=false
# The highest tier whose features passed live QA: CASE_WATCH, CASE_PRO or CASE_COMMAND. Blank = none.
CHAMPION_CASE_VERIFIED_THROUGH=
CHAMPION_CASE_WATCH_PRICE_ID=
CHAMPION_CASE_PRO_PRICE_ID=
CHAMPION_CASE_COMMAND_PRICE_ID=

# ---------------------------------------------------------------------------------------------
# Performance and data retention (docs/PERFORMANCE.md) - blank = the built-in default
# ---------------------------------------------------------------------------------------------

# How long a Discord publisher's route lookup may block on a cache miss before falling back to the
# legacy channel, e.g. 750ms. Default 500ms; values under 50ms are ignored.
ROUTE_LOOKUP_TIMEOUT=
# PostgreSQL connection pool. Defaults: 25 max, 2 min, 30m max lifetime, 5m max idle time,
# 1m health check period.
DATABASE_MAX_CONNS=
DATABASE_MIN_CONNS=
DATABASE_MAX_CONN_LIFETIME=
DATABASE_MAX_CONN_IDLE_TIME=
DATABASE_HEALTH_CHECK_PERIOD=
# A query at or above this many milliseconds is logged at WARN with its SQL text (never argument
# values). Default 250.
SLOW_QUERY_THRESHOLD_MS=

# Days of player location history to keep. Default 30.
CHAMPION_LOCATION_RETENTION_DAYS=
# Days to keep rows of a diagnostics table: CHAMPION_RETENTION_DAYS_<TABLE NAME IN CAPITALS>.
# Default 14 for both.
CHAMPION_RETENTION_DAYS_COMBAT_ANOMALY_FLAGS=
CHAMPION_RETENTION_DAYS_LIVE_SYNC_RECORDS=

# ---------------------------------------------------------------------------------------------
# Not settings of the bot
# ---------------------------------------------------------------------------------------------
# Set by Railway itself and read by the bot: RAILWAY_PUBLIC_DOMAIN (see CHAMPION_PUBLIC_BASE_URL)
# and RAILWAY_GIT_COMMIT_SHA (shown as the running version).
# Integration tests only (see README.md "Tests"): TEST_DATABASE_URL, ALLOW_INTEGRATION_DB_TESTS,
# REQUIRE_INTEGRATION_DB.
# The helper tools in cmd/ read a few variables of their own; see docs/TOOLS.md.
# The Owner Hub API also looks up CHAMPION_SAAS_API_SECRET, DISCORD_CLIENT_SECRET and RAILWAY_TOKEN,
# only so that a response which would contain one of them is withheld. They configure nothing here.
